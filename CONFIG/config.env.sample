vendorId=
machineId=1
TRANSACTION_DIR=/home/dgsi/Desktop/sabon_vendo_cashier/transaction

# --- Socket server ---
SOCKET_IP = "127.0.0.1"
SOCKET_PORT = 8080

# --- Cashier dashboard ---
# HTTP port for the web dashboard. 80 lets cashiers reach it at a bare
# http://<pi-ip>/ but needs root to bind, which is why PM2 runs it via sudo.
DASHBOARD_PORT = 80

# --- Cloud API ---
API_BASE_URL = "https://office.dynamicglobalsoft.com:1232"

# --- Runtime ---
PUMP_START_COOLDOWN_MS = 200

# --- Prime / purge ---
# How long one prime burst runs, in seconds. Priming clears air from a hose
# after a gallon change, so the next customer is not charged for a press that
# dispenses nothing. A prime records NO sale; it is appended to PRIME_LOG
# instead. The controller clamps this to 0.5-15s -- too long empties a gallon
# onto the floor unattended.
PRIME_SECONDS = 3

# How long an unlocked button stays live before the credits are written off.
# Seconds, clamped to 30..1800, default 300 (five minutes). The button is
# physically live for this whole window -- anyone can press it -- so raise it
# only as far as the counter actually needs.
ARM_TIMEOUT_SECONDS=300

# Where prime events are recorded, one JSON object per line. Must stay OUTSIDE
# TRANSACTION_DIR: the uploader sends every file in that directory to the
# cloud as a sale. Defaults to <repo>/logs/prime_events.jsonl.
PRIME_LOG = /home/dgsi/Desktop/sabon-vendo-cashier/logs/prime_events.jsonl

# --- Local sales archive ---
# transaction_uploader.py appends every confirmed sale here just before it
# deletes the record. Without it the machine has no memory of its own trading:
# the transaction directory is empty seconds after a sale, so nothing on site
# could answer "what sold today".
SALES_ARCHIVE_DIR = /home/dgsi/Desktop/sabon-vendo-cashier/logs/sales

# Sales cut short by an empty tank. The customer was charged in full, so the
# sale is recorded in full -- but the pour was partial, and only a person can
# settle that with them. The dashboard shows today's entries under Needs
# Attention. Must stay OUTSIDE TRANSACTION_DIR.
INTERRUPTED_LOG = /home/dgsi/Desktop/sabon-vendo-cashier/logs/interrupted_sales.jsonl

# How each unclaimed credit was settled: re-armed for the customer, or
# written off as a loss. RESOLVED_FILE records only THAT a credit was dealt
# with; without this the difference survives nowhere but a pm2 line that
# rotates out in a week. Must stay OUTSIDE TRANSACTION_DIR.
SETTLEMENT_LOG = /home/dgsi/Desktop/sabon-vendo-cashier/logs/credit_settlements.jsonl

# Credits paid for but never dispensed -- expired at the timeout, or cancelled
# by the cashier. Not sales: this file must stay outside TRANSACTION_DIR or the
# uploader will book them as revenue.
UNCLAIMED_LOG = /home/dgsi/Desktop/sabon-vendo-cashier/logs/unclaimed_credits.jsonl

# --- Products (per client) ---
# What is actually loaded in each slot. Different clients stock different
# things, so these must not be assumed. The dashboard shows these names, and
# the local sales report labels its figures with them.
#
# The cloud receives only the slot number, so keep a record of which product
# each slot holds on each machine -- otherwise a report elsewhere can only say
# "slot 3".
PRODUCT1_NAME = Detergent 1
PRODUCT2_NAME = Detergent 2
PRODUCT3_NAME = Fabcon 1
PRODUCT4_NAME = Fabcon 2
PRODUCT5_NAME = Bleach Original
PRODUCT6_NAME = Bleach Colored

# Millilitres dispensed per press, for display only. The pump is timed by
# calibrateProductN; this is what the cashier is told they are selling.
PRODUCT1_ML = 75
PRODUCT2_ML = 75
PRODUCT3_ML = 60
PRODUCT4_ML = 60
PRODUCT5_ML = 100
PRODUCT6_ML = 100

# --- Pump calibration (per machine, physically measured) ---
# (price, seconds) -- only the SECONDS are used here; PRICEn below sets price.
# The seconds decide how long the pump runs, so they decide how much liquid the
# customer actually gets. They differ per pump, per tube length and per liquid
# viscosity, so they CANNOT be copied between machines.
#
# If these are absent the controller falls back to compiled-in defaults measured
# on a different machine -- it will run and look healthy while pouring the wrong
# volume. Measure them on this Pi. See docs/INSTALLATION.md section 7b.
calibrateProduct1 = (5, 2.777778)
calibrateProduct2 = (5, 1.363636)
calibrateProduct3 = (5, 1.25)
calibrateProduct4 = (5, 2.0)
calibrateProduct5 = (5, 2.0)
calibrateProduct6 = (5, 2.0)

# --- Prices (per client) ---
# Price per press, in whole pesos. This is what reaches the cloud as the
# transaction "amount", so it must match what the customer actually pays.
#
# Editable from the dashboard (Settings -> Prices). A change made there is
# written to PRICES_FILE, which OVERRIDES these values on the next start --
# otherwise a restart would quietly undo whatever the owner set on site.
# Every change is appended to PRICE_LOG with its old value.
#
# If PRICEn is absent the first number of calibrateProductN is used instead,
# so machines on the older layout keep working untouched.
PRICE1 = 5
PRICE2 = 5
PRICE3 = 5
PRICE4 = 5
PRICE5 = 5
PRICE6 = 5

PRICES_FILE = /home/dgsi/Desktop/sabon-vendo-cashier/CONFIG/prices.conf
PRICE_LOG   = /home/dgsi/Desktop/sabon-vendo-cashier/logs/price_changes.jsonl

# --- 6-slot pin map (BCM) ---
BTN1 = 14
BTN2 = 24
BTN3 = 25
BTN4 = 10
BTN5 = 13
BTN6 = 23

PUMP1 = 15
PUMP2 = 16
PUMP3 = 6
PUMP4 = 17
PUMP5 = 18
PUMP6 = 12

LED1 = 5
LED2 = 27
LED3 = 4
LED4 = 22
LED5 = 19
LED6 = 7

PUMP_TRIGGER_HIGH = 0
PUMP_TRIGGER_LOW = 1

# Which level a water level sensor reports when its slot is EMPTY.
#   1 = empty reads HIGH (default)
#   0 = empty reads LOW
# Sensors are wired GPIO -> GND with a pull-up, so a disconnected sensor reads
# HIGH. The default fails safe: a dead sensor looks empty and the pump is
# blocked rather than left to run dry. If a full slot reports empty on real
# hardware, set this to 0 and restart 01_Dispenser_Controller -- no rebuild needed.
WATER_SENSOR_EMPTY_HIGH = 1

# --- Water level sensors (one per slot) ---
WATER_GPIO_PIN_1 = 26
WATER_GPIO_PIN_2 = 20
WATER_GPIO_PIN_3 = 21
WATER_GPIO_PIN_4 = 11
WATER_GPIO_PIN_5 = 8
WATER_GPIO_PIN_6 = 9
